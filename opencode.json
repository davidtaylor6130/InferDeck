{
  "$schema": "https://opencode.ai/config.json",
  "model": "inferdeck/Normal",
  "small_model": "inferdeck/qwen2.5-0.5b-instruct",
  "provider": {
    "inferdeck": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "InferDeck",
      "options": {
        "baseURL": "http://192.168.0.168:11434/v1"
      },
      "models": {
        "Normal": {
          "name": "Normal",
          "limit": {
            "context": 100000,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "qwen2.5-0.5b-instruct": {
          "name": "qwen2.5-0.5b-instruct",
          "limit": {
            "context": 4096,
            "output": 4096
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
